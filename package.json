{
  "name": "@authkit/passkeys",
  "version": "0.1.0",
  "description": "Lightweight, framework-agnostic passkey/WebAuthn library — isomorphic core for browser, Node and edge runtimes (Cloudflare Workers, Vercel Edge, Deno, Bun). <6KB gzipped client core, <12KB gzipped default server bundle (none + packed attestation; apple/fido-u2f/tpm/android-key are dynamic imports). Zero runtime cbor/asn1 dependencies.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mykhailo Kryvytskyi",
    "email": "jack.981@yahoo.com"
  },
  "homepage": "https://github.com/j09822475-dev/authkit-passkeys#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j09822475-dev/authkit-passkeys.git"
  },
  "bugs": {
    "url": "https://github.com/j09822475-dev/authkit-passkeys/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/browser/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "workerd": "./dist/server/index.js",
      "edge-light": "./dist/server/index.js",
      "deno": "./dist/server/index.js",
      "import": "./dist/server/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "import": "./dist/storage/memory.js"
    },
    "./storage/types": {
      "types": "./dist/storage/types.d.ts",
      "import": "./dist/storage/types.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#webcrypto-shim": {
      "types": "./dist/core/crypto/webcrypto-shim.d.ts",
      "workerd": "./dist/core/crypto/webcrypto-shim.js",
      "edge-light": "./dist/core/crypto/webcrypto-shim.js",
      "deno": "./dist/core/crypto/webcrypto-shim.js",
      "browser": "./dist/core/crypto/webcrypto-shim.js",
      "node": "./dist/core/crypto/webcrypto-shim.node.js",
      "default": "./dist/core/crypto/webcrypto-shim.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src tests",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,json,md}\"",
    "size": "size-limit",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "release": "changeset publish",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run size"
  },
  "keywords": [
    "passkey",
    "passkeys",
    "webauthn",
    "fido2",
    "passwordless",
    "authentication",
    "auth",
    "mfa",
    "2fa",
    "phishing-resistant",
    "biometric",
    "typescript",
    "edge",
    "zero-dependencies"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "happy-dom": "^14.12.0",
    "prettier": "^3.3.0",
    "size-limit": "^11.1.0",
    "tsup": "^8.2.0",
    "typescript": "~5.6.3",
    "vitest": "^1.6.0"
  },
  "size-limit": [
    {
      "name": "browser ceremony (startRegistration + startAuthentication)",
      "path": "dist/browser/index.js",
      "limit": "6 KB"
    },
    {
      "name": "server default bundle (none + packed; ES256 + EdDSA + RS256)",
      "path": "dist/server/index.js",
      "limit": "12 KB"
    },
    {
      "name": "errors only",
      "path": "dist/errors/index.js",
      "limit": "1.5 KB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
